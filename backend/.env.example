APP_NAME="DuoFest API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Public URL of the frontend (used to build email links)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Database
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=duofest
DB_USERNAME=root
DB_PASSWORD=

# Alternative: use SQLite for local development without a server
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Mail
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@duofest.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------------
# Sanctum
#--------------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=7

#--------------------------------------------------------------------------
# Firebase Authentication
#--------------------------------------------------------------------------
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=
# Path to the Firebase service-account JSON file
FIREBASE_CREDENTIALS_FILE=
# Raw JSON alternative to FIREBASE_CREDENTIALS_FILE
FIREBASE_CREDENTIALS_JSON=
FIREBASE_API_KEY=

#--------------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Accept,Authorization,X-Requested-With,X-API-Version,Origin
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

#--------------------------------------------------------------------------
# API
#--------------------------------------------------------------------------
API_VERSION=v1
API_PREFIX=api
API_TOKEN_NAME=duofest
API_TOKEN_EXPIRY_DAYS=7
API_PER_PAGE=15
API_MAX_PER_PAGE=100
API_DEFAULT_USER_ROLE=student

#--------------------------------------------------------------------------
# Activity Logging
#--------------------------------------------------------------------------
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_PRUNE_DAYS=90
ACTIVITY_LOG_REQUESTS=true

VITE_APP_NAME="${APP_NAME}"
